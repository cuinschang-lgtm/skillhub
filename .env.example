# ------------------------------------------------------------
# SkillHub website runtime environment
# See docs/deploy-skillhub.md for deployment guidance.
# ------------------------------------------------------------

# Required: auth / API basics
JWT_SECRET=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API / storage
DATABASE_URL=sqlite+aiosqlite:///./storage/skillhub.db
REDIS_URL=
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Web -> API proxy
SKILLHUB_API_BASE_URL=http://127.0.0.1:8000
# SKILLHUB_API_HOSTPORT=api:8000

# LLM / OCR
DEEPSEEK_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINERU_TOKEN=

# Behavior flags
DEFAULT_LLM_PROVIDER=deepseek
ALLOW_PARTIAL_SKILL=true

# Optional: kept only for deployment parity with some existing configs.
# Current app code does not require this variable.
SKILLHUB_SESSION_SECRET=
